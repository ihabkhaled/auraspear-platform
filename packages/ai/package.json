{
  "name": "@auraspear/ai",
  "version": "1.0.0",
  "private": true,
  "description": "Shared AI building blocks for the AuraSpear platform: output contracts, redaction, provider routing, safety/approval policy, and an evaluation harness. Dependency-free so both web and api can consume it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:ci": "tsc --noEmit --pretty",
    "typecheck:fast": "tsgo -p tsconfig.json --noEmit --pretty",
    "lint": "echo \"(ai) lint via consumers\"",
    "lint:strict": "echo \"(ai) lint via consumers\""
  }
}
