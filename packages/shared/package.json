{
  "name": "@auraspear/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared contracts for the AuraSpear platform: enums, types, permissions, API response shapes, and Zod schemas used by both web and api.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:ci": "tsc --noEmit --pretty",
    "typecheck:fast": "tsgo -p tsconfig.json --noEmit --pretty",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@auraspear/config": "workspace:*",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3"
  }
}
