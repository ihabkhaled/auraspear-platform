# =============================================================================
# AuraSpear Platform — ROOT environment file (Docker Compose)
# =============================================================================
# This file is read by `docker compose` at the repo root to interpolate values
# into infra/docker/*.yml. Copy it and fill in real secrets:
#
#   cp .env.example .env            # then edit .env (never commit .env)
#   pnpm setup:env                  # or generate secrets automatically
#
# For LOCAL (non-Docker) development each app has its OWN env file:
#   apps/api/.env   (copy from apps/api/.env.example)
#   apps/web/.env   (copy from apps/web/.env.example)
#
# Generate the two required secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# ---------- Ports (host bindings) ----------
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=auraspear_soc
POSTGRES_USER=auraspear
POSTGRES_PASSWORD=change-me-strong-password
# In Docker the API reaches Postgres at host "postgres". DATABASE_URL is composed
# from the values above by docker-compose; override here only for external DBs.
# DATABASE_URL="postgresql://auraspear:change-me-strong-password@postgres:5432/auraspear_soc?schema=public"

# ---------- Redis ----------
# Required (>= 16 chars) when NODE_ENV=production.
REDIS_PASSWORD=

# ---------- pgAdmin (dev/infra only) ----------
PGADMIN_EMAIL=admin@auraspear.io
PGADMIN_PASSWORD=change-me

# ---------- Application ----------
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated http/https origins. MUST NOT contain localhost in production.
CORS_ORIGINS=http://localhost:3000

# ---------- Secrets (REQUIRED) ----------
# Exactly 64 hex chars (32 bytes, AES-256-GCM). Must not be all zeros.
CONFIG_ENCRYPTION_KEY=
# >= 64 hex chars. Must not be all zeros.
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Seeding (REQUIRED for first run) ----------
# Strong password (12+ chars) for the seeded platform admin account.
SEED_DEFAULT_PASSWORD=

# ---------- Frontend → Backend wiring ----------
# Server-side URL the web container uses to reach the API (Docker network).
BACKEND_API_URL=http://api:4000/api/v1
# Browser-facing base path (proxied by the web app to the API).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=AuraSpear SOC
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_MSW=false

# ---------- OIDC / Microsoft Entra ID (optional — all-or-nothing) ----------
# OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant-id}/v2.0
# OIDC_AUDIENCE=api://auraspear-soc
# OIDC_JWKS_URI=https://login.microsoftonline.com/{tenant-id}/discovery/v2.0/keys
# OIDC_CLIENT_ID=your-client-id

# ---------- AWS Bedrock (optional — AI provider) ----------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
