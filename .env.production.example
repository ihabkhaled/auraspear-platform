# =============================================================================
# AuraSpear Platform — PRODUCTION environment overrides
# =============================================================================
# Start from .env.example (the full reference) and apply the production-grade
# values below. The backend's Zod env validation (apps/api/src/config/
# env.validation.ts) ENFORCES several of these at boot — the app will refuse to
# start if they are weak or missing.
#
#   cp .env.example .env.production       # then harden the values below
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# REQUIRED & ENFORCED in production:
#   - REDIS_PASSWORD must be >= 16 characters
#   - CONFIG_ENCRYPTION_KEY exactly 64 hex chars (not all zeros)
#   - JWT_SECRET >= 64 hex chars (not all zeros)
#   - CORS_ORIGINS must be real https origins (NO localhost / 127.0.0.1)
REDIS_PASSWORD=
CONFIG_ENCRYPTION_KEY=
JWT_SECRET=
CORS_ORIGINS=https://soc.yourcompany.com

# Strong, unique admin seed password (12+ chars). Rotate after first login.
SEED_DEFAULT_PASSWORD=

# Internal service hostnames (Docker network). Do NOT expose 5432/6379/5050
# publicly — the production compose binds only the web/api ports.
POSTGRES_PASSWORD=
BACKEND_API_URL=http://api:4000/api/v1
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_MSW=false

# Enable an AI provider only if used. Prefer IAM roles over static AWS keys.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
