# ── Dependencies ──────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ──────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Test / coverage ───────────────────────────────────────
coverage/
test-results/
playwright-report/
eslint-reports/

# ── Environment (never commit real secrets) ───────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.docker
# Allow example/template files
!.env.example
!.env.*.example

# ── Prisma ────────────────────────────────────────────────
prisma/migrations/**/migration_lock.toml

# ── PWA (generated by serwist) ────────────────────────────
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/serwist-worker-*.js
apps/web/public/serwist-worker-*.js.map

# ── Editor / OS ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.pem

# ── Logs ──────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Misc ──────────────────────────────────────────────────
.vercel
.claude/
